{
    "name": "plutuss/amember-pro-laravel",
    "description": "aMember allows you to receive and send information about users, products and payments",
    "keywords": [
        "laravel",
        "aMember",
        "AMember",
        "AMember Pro",
        "AMember REST API",
        "AMember Admin",
        "AMember dashboard"
    ],
    "minimum-stability": "stable",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "plutuss",
            "email": "dima92konovalenko@gmail.com",
            "homepage": "https://github.com/plutuss"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Plutuss\\AMember\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plutuss\\AMember\\Providers\\AMemberServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Plutuss\\AMember\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:unit": "@php tests/run.php"
    }
}
