{
    "name": "plutuss/amember-pro-laravel",
    "description": "Laravel REST API client for aMember Pro: members, subscriptions, products, invoices, payments, access control and affiliate payouts.",
    "keywords": [
        "amember",
        "amember-pro",
        "amember-api",
        "amember-rest-api",
        "laravel",
        "laravel-package",
        "laravel-integration",
        "php",
        "api-client",
        "rest-client",
        "rest-api",
        "membership",
        "membership-management",
        "members",
        "subscriptions",
        "subscription-management",
        "access-control",
        "products",
        "billing-plans",
        "invoices",
        "payments",
        "refunds",
        "affiliate",
        "affiliate-payouts",
        "pagination"
    ],
    "minimum-stability": "stable",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "plutuss",
            "email": "dima92konovalenko@gmail.com",
            "homepage": "https://github.com/plutuss"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Plutuss\\AMember\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plutuss\\AMember\\Providers\\AMemberServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Plutuss\\AMember\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:unit": "@php tests/run.php"
    },
    "homepage": "https://github.com/plutuss/amember-pro-laravel",
    "support": {
        "issues": "https://github.com/plutuss/amember-pro-laravel/issues",
        "source": "https://github.com/plutuss/amember-pro-laravel",
        "docs": "https://github.com/plutuss/amember-pro-laravel/blob/master/README.md"
    },
    "readme": "README.md",
    "scripts-descriptions": {
        "test": "Run Laravel integration tests with PHPUnit and Orchestra Testbench",
        "test:unit": "Run the standalone HTTP client regression suite"
    }
}
