<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Laravel integration">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include><directory>src</directory></include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="AMEMBER_URL" value="https://amember.test/api"/>
        <env name="AMEMBER_API_KEY" value="test-key"/>
    </php>
</phpunit>
